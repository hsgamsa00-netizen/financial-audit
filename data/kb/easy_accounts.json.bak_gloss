[
 {
  "id": "af_단기매매채무·지분증권·만기보유증권·매도가능채무(직영기업)",
  "쉬운설명": "기관이 여윳돈으로 사 둔 채권(돈을 빌려주고 받은 차용증 성격의 증권)이나 주식을 목적별로 나눠 부르는 이름입니다. 1년 안에 팔 생각이면 '단기매매', 만기까지 갖고 있을 생각이면 '만기보유', 둘 다 아니면 '매도가능'으로 분류합니다.",
  "구체예시": "2024년에 여유자금으로 회사채 5억 원어치를 사면서 1년 안에 팔 계획이면 단기매매채무증권 5억, 3년 만기까지 보유할 계획이면 만기보유증권 5억으로 기록합니다.",
  "감사포인트": "취득 당시의 보유 목적과 실제 분류가 일치하는지, 만기가 1년 안으로 다가온 증권을 유동성 계정으로 옮겼는지 확인합니다."
 },
 {
  "id": "af_영업미수금",
  "쉬운설명": "수도요금·사용료를 부과(징수 결정)했는데 아직 받지 못한 돈입니다. 외상값을 받을 권리라고 보면 되고, 연체금도 포함됩니다.",
  "구체예시": "2024년 12월분 수도요금 8억 원을 고지했는데 연말까지 6억 원만 수납되면, 남은 2억 원이 영업미수금으로 장부에 남습니다.",
  "감사포인트": "오래 묵은 미수금이 회수 노력 없이 방치되고 있지 않은지, 소멸시효가 지나 못 받게 된 금액은 없는지 확인합니다."
 },
 {
  "id": "af_분양미수금(직영기업)",
  "쉬운설명": "택지나 주택을 분양하고 아직 받지 못한 분양대금입니다. 1년 안에 받을 것은 분양미수금, 그 이후에 받을 것은 장기분양미수금으로 나눕니다.",
  "구체예시": "2024년에 택지를 20억 원에 분양하고 계약금 5억 원만 받았다면, 나머지 15억 원이 분양미수금으로 기록됩니다.",
  "감사포인트": "분양계약 해지·연체 건의 미수금이 실제 회수 가능한지, 연체료 부과와 독촉 절차가 제때 이뤄졌는지 확인합니다."
 },
 {
  "id": "af_기타미수금",
  "쉬운설명": "수도요금 같은 주된 사업 외의 활동에서 받을 돈이 확정됐는데 아직 안 들어온 것입니다. 부대시설 임대료나 수수료 미수금이 여기에 해당합니다.",
  "구체예시": "청사 1층 매점 임대료 1,200만 원이 12월 말 기준 미납이면, 이 금액이 기타미수금으로 잡힙니다.",
  "감사포인트": "임대료 등 소액 미수금이 담당자 교체 후 잊혀 장기 방치되지 않았는지 확인합니다."
 },
 {
  "id": "af_선급금(직영기업)",
  "쉬운설명": "물품이나 원재료를 사기로 하고 물건을 받기 전에 미리 준 돈(계약금·착수금)입니다. 물건이 들어오면 그때 해당 자산 계정으로 옮겨집니다.",
  "구체예시": "2024년 3월 약품 구매계약을 맺고 착수금 2억 원을 먼저 지급하면 선급금 2억이 생기고, 약품이 납품되면 저장품 등으로 대체됩니다.",
  "감사포인트": "물건을 이미 받았는데도 선급금이 정리되지 않고 남아있지 않은지, 지급 근거(계약서·선금 규정)가 있는지 확인합니다."
 },
 {
  "id": "af_공사선급금(직영기업)",
